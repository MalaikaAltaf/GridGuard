# Database Configuration
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT Configuration
JWT_SECRET_KEY=change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRY_DAYS=7

# Risk Band Thresholds
RISK_BAND_HIGH_THRESHOLD=0.7
RISK_BAND_MEDIUM_THRESHOLD=0.4

# Storage Configuration
STORAGE_PATH=./uploads

# Inspector Availability Threshold (minutes)
INSPECTOR_AVAILABILITY_THRESHOLD_MINUTES=15

# ML Model Path
MODEL_PATH=./ml-artifact/model.pkl
